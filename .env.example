# Copy to .env only for local experiments. Prefer scripts/with-secrets.sh,
# which reads keys from GCP Secret Manager into the process environment
# without writing them to disk. Never commit a filled-in .env.

# Only "demo" is accepted. There is no live-trading endpoint in this codebase.
TRADING_MODE=demo

# Local default is SQLite; Docker Compose sets a Postgres URL.
DATABASE_URL=sqlite+aiosqlite:///./data/engine.db

CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=

BINANCE_API_KEY=
BINANCE_API_SECRET=

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
